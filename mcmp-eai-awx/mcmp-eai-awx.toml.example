[LOGGING]
Level      = "INFO"   # Log level: DEBUG, INFO, WARN, ERROR
Output     = "file"   # Output destination: console, file, both
Format     = "plain"  # Output format: text, json, plain
Filename   = "/var/log/mcmp-eai-awx.log"
MaxSize    = 10       # Maximum file size in MB before rotation
MaxBackups = 7        # Number of old log files to retain
MaxAge     = 30       # Maximum age in days for log files
Compress   = true     # Compress rotated log files

[[AWX]]
Enabled                           = true
Username                          = 'user'
Password                          = '********************'
ApiEndpoint                       = 'https://awx1.example.com'
LinuxRootPermitsInventoryId       = 1
WindowsAdminPermitsInventoryId    = 2
WindowsMaintenanceModeInventoryId = 3

[[AWX]]
Enabled                           = false
Username                          = 'user'
Password                          = '********************'
ApiEndpoint                       = 'https://awx2.example.com'
LinuxRootPermitsInventoryId       = 1
WindowsAdminPermitsInventoryId    = 2
WindowsMaintenanceModeInventoryId = 3

[[MCMP]]
OAuthUrl          = 'http://kubernetes.docker.internal:8100/auth'
OAuthRealm        = 'local_realm'
OAuthClientId     = 'local'
OAuthClientSecret = 'client_secret'
ApiEndpoint       = 'http://localhost:8080/clients/eai-backend-service/awx/import'

[[MCMP]]
OAuthUrl          = 'http://kubernetes.docker.internal:8100/auth'
OAuthRealm        = 'local_realm'
OAuthClientId     = 'local'
OAuthClientSecret = 'client_secret'
ApiEndpoint       = 'https://mcmp2.example.org/clients/eai-backend-service/awx/import'
