{
  "name": "mcmp-frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11.6 <12"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --noCheck && vite build && npm run post-build",
    "post-build": "cyclonedx-npm --omit dev --omit optional --output-reproducible -o dist/application.cdx.json",
    "lint": "prettier . --check --cache && eslint . --cache --concurrency auto && vue-tsc --build --noEmit",
    "fix": "prettier . --write --cache && eslint . --fix --cache --concurrency auto",
    "fix prettier": "prettier . --write --cache",
    "build:war": "npm run build && node build-war.js",
    "security:check": "npm audit && dependency-check --project mcmp-frontend --scan ./node_modules --out ./reports --enableExperimental false",
    "security:check-html": "dependency-check.sh --project mcmp-frontend --scan ./node_modules --out ./reports --format HTML --enableExperimental false --disableYarnAudit"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@vueuse/core": "14.3.0",
    "archiver": "^8.0.0",
    "echarts": "^6.0.0",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "11.4.7",
    "vue-router": "5.2.0",
    "vuetify": "3.12.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@intlify/unplugin-vue-i18n": "11.2.4",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@pinia/testing": "2.0.1",
    "@tsconfig/node-lts": "24.0.0",
    "@types/node": "24.11.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "unplugin-fonts": "2.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "esbuild": ">=0.21.0",
    "brace-expansion": ">=2.0.1",
    "minimatch": ">=9.0.0",
    "glob": ">=10.0.0"
  },
  "allowScripts": {}
}
