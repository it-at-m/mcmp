{
  "name": "mcmp-frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --noCheck && vite build && npm run post-build",
    "post-build": "cyclonedx-npm --omit dev --omit optional --output-reproducible -o dist/application.cdx.json",
    "lint": "prettier . --check --cache && eslint . --cache --concurrency auto && vue-tsc --build --noEmit",
    "fix": "prettier . --write --cache && eslint . --fix --cache --concurrency auto",
    "build:war": "npm run build && node build-war.js",
    "security:check": "npm audit && dependency-check --project mcmp-frontend --scan ./node_modules --out ./reports --enableExperimental false",
    "security:check-html": "dependency-check.sh --project mcmp-frontend --scan ./node_modules --out ./reports --format HTML --enableExperimental false --disableYarnAudit"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@vueuse/core": "14.3.0",
    "archiver": "^8.0.0",
    "echarts": "^6.0.0",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "11.4.4",
    "vue-router": "5.0.7",
    "vuetify": "4.0.7"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.4.0",
    "@intlify/unplugin-vue-i18n": "11.2.3",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@pinia/testing": "1.0.3",
    "@tsconfig/node-lts": "24.0.0",
    "@types/node": "25.9.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.10",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.4.0",
    "eslint-plugin-vue": "10.9.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "unplugin-fonts": "2.0.0",
    "vite": "8.0.13",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.7",
    "vue-tsc": "3.3.1"
  },
  "overrides": {
    "vue-i18n": "11.4.4"
  }
}
