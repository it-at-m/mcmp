# =============================================================================
# General Application Settings
# =============================================================================
[GENERAL]
Timeout = 300         # Global timeout in seconds (default: 300 = 5 minutes)

# =============================================================================
# Logging Configuration
# =============================================================================
[LOGGING]
Level      = "INFO"   # Log level: DEBUG, INFO, WARN, ERROR
Output     = "file"   # Output destination: console, file, both
Format     = "plain"  # Output format: text, json, plain
Filename   = "/var/log/mcmp-eai-netapp-ontap/application.log"
MaxSize    = 100      # Maximum file size in MB before rotation
MaxBackups = 7        # Number of old log files to retain
MaxAge     = 30       # Maximum age in days for log files
Compress   = true     # Compress rotated log files

# =============================================================================
# NetApp ONTAP Sources
# Multiple ONTAP systems can be configured using [[ONTAP]] sections
# =============================================================================

# Primary ONTAP cluster
[[ONTAP]]
Hostname  = "ontap1.example.com"
Username  = "<your-username>"
Password  = "<your-password>"
Enabled   = true
VerifyTLS = false     # Set to true in production environments

# Secondary ONTAP cluster (disabled by default)
[[ONTAP]]
Hostname  = "ontap2.example.com"
Username  = "<your-username>"
Password  = "<your-password>"
Enabled   = false
VerifyTLS = false

# =============================================================================
# MCMP API Configuration
# OAuth2 client credentials for authentication with the MCMP backend
# =============================================================================
[[MCMP]]
OAuthUrl          = 'http://kubernetes1.docker.internal:8100/auth'
OAuthRealm        = 'local_realm'
OAuthClientId     = 'local'
OAuthClientSecret = 'client_secret'
ApiEndpoint       = "https://mcmp1.example.com/clients/eai-backend-service/netapp/ontap/update"

[[MCMP]]
OAuthUrl          = 'http://kubernetes2.docker.internal:8100/auth'
OAuthRealm        = 'local_realm'
OAuthClientId     = 'local'
OAuthClientSecret = 'client_secret'
ApiEndpoint       = 'https://mcmp2.example.org/clients/eai-backend-service/netapp/ontap/update'